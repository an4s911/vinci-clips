# Domain and Let's Encrypt settings for Docker production.
# For local production-style testing, use APP_DOMAIN=localhost.
APP_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Gemini API settings. GEMINI_API_KEY is required.
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# Redis is used by the Docker stack. Use a strong password in production.
REDIS_PASSWORD=change_this_redis_password

# Public URLs used by the browser and backend CORS.
# Keep NEXT_PUBLIC_API_URL=/api when nginx serves frontend and backend together.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://example.com

# Local media cleanup and optional storage admin protection.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1
MEDIA_ADMIN_TOKEN=
