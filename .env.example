# Domain and Let's Encrypt settings for Docker production.
# For local production-style testing, use APP_DOMAIN=localhost.
APP_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Gemini API settings. GEMINI_API_KEY is required.
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# Audio transcription chunking. For higher usage, set duration to 300, overlap to 30, and concurrency to 4.
CHUNK_DURATION_SEC=180
CHUNK_OVERLAP_SEC=20
CHUNK_CONCURRENCY=1

# Redis is used by the Docker stack. Use a strong password in production.
REDIS_PASSWORD=change_this_redis_password

# PostgreSQL database. Use strong credentials in production.
POSTGRES_DB=vinci_clips
POSTGRES_USER=vinci
POSTGRES_PASSWORD=change_this_postgres_password
# Host port for local Docker Compose access. Change to 5433 if your machine
# already has PostgreSQL listening on 5432.
POSTGRES_PORT=5432

# Session secret — generate with: openssl rand -base64 48
SESSION_SECRET=change_this_session_secret

# Public URLs used by the browser and backend CORS.
# Keep NEXT_PUBLIC_API_URL=/api when nginx serves frontend and backend together.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://example.com

# Local media cleanup and optional storage admin protection.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1
MEDIA_ADMIN_TOKEN=

# Optional yt-dlp settings for YouTube imports from VPS/server IPs.
# Export Netscape-format YouTube cookies and place the file under backend/storage,
# then set this to the in-container path, for example:
# YTDLP_COOKIES_PATH=/app/storage/yt-dlp-cookies.txt
YTDLP_COOKIES_PATH=
YTDLP_USER_AGENT=
# POT provider for YouTube bot detection bypass (recommended for VPS deployments).
# The pot-provider service in docker-compose.prod.yml handles token generation.
# Set this to enable it — no account or cookies required.
YTDLP_EXTRACTOR_ARGS=youtubepot-bgutilhttp:base_url=http://pot-provider:4416
