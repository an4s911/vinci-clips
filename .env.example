# Domain and Let's Encrypt settings for Docker production.
# For local production-style testing, use APP_DOMAIN=localhost.
APP_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Gemini API settings. GEMINI_API_KEY is required for the analyze (clip selection) stage.
# Transcription is handled locally by whisper.cpp — no Gemini calls during transcribe.
GEMINI_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# whisper.cpp local transcription.
# Binary and model are baked into the Docker image at build time.
# Override only if you place a different model in backend/models/.
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/app/models/ggml-large-v3-turbo.bin
# CPU threads for whisper (default: all available). Tune down on shared hosts.
WHISPER_THREADS=
# Language hint — "en" skips auto-detect and is slightly faster for English-only content.
WHISPER_LANGUAGE=

# Redis is used by the Docker stack. Use a strong password in production.
REDIS_PASSWORD=change_this_redis_password

# PostgreSQL database. Use strong credentials in production.
POSTGRES_DB=vinci_clips
POSTGRES_USER=vinci
POSTGRES_PASSWORD=change_this_postgres_password
# Host port for local Docker Compose access. Change to 5433 if your machine
# already has PostgreSQL listening on 5432.
POSTGRES_PORT=5432

# Session secret — generate with: openssl rand -base64 48
SESSION_SECRET=change_this_session_secret

# Public URLs used by the browser and backend CORS.
# Keep NEXT_PUBLIC_API_URL=/api when nginx serves frontend and backend together.
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://example.com

# Local media cleanup and optional storage admin protection.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1
MEDIA_ADMIN_TOKEN=

# YouTube Data API v3 key — used for video metadata on all URL imports.
# Get one at https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# Download provider: ytdlp (default) or savenow
VIDEO_DOWNLOAD_PROVIDER=ytdlp

# savenow (video-download-api.com) settings — only needed when VIDEO_DOWNLOAD_PROVIDER=savenow
VIDEO_DOWNLOAD_API_HOST=p.savenow.to
VIDEO_DOWNLOAD_API_KEY=
VIDEO_DOWNLOAD_FORMAT=1080

# yt-dlp bot-detection bypass settings (recommended for VPS/server IPs)
# Uses bgutil-ytdlp-pot-provider Docker sidecar for PO token generation.
# See docker-compose.prod.yml — bgutil-provider service runs on port 4416.
YTDLP_BGUTIL_URL=http://bgutil-provider:4416

# Cookies: export Netscape-format YouTube cookies from Firefox, place under backend/storage/,
# and set to the in-container path. Re-export every 2-4 weeks.
# Example: YTDLP_COOKIES_PATH=/app/cookies/yt-cookies.txt
YTDLP_COOKIES_PATH=
YTDLP_USER_AGENT=

# Cookie expiry monitor — warns in logs (and optional webhook) before cookies expire.
# Re-export cookies every 2-4 weeks using .inbox/export_yt_cookies.py + scp + chown 1001:1001.
COOKIE_MONITOR_ENABLED=true
COOKIE_MONITOR_INTERVAL_HOURS=12
COOKIE_WARN_DAYS=3
# Optional: Slack/Discord incoming webhook URL to receive expiry alerts
COOKIE_ALERT_WEBHOOK=

# BullMQ pipeline worker concurrency.
PIPELINE_NETWORK_CONCURRENCY=3
PIPELINE_TRANSCRIBE_CONCURRENCY=2
PIPELINE_MEDIA_CONCURRENCY=2
PIPELINE_STAGE_ATTEMPTS=3
PIPELINE_BACKOFF_MS=5000

# Job priority (lower number = runs sooner). Pipeline stages beat manual edits.
PIPELINE_PRIORITY_STAGE=1
PIPELINE_PRIORITY_CLIP=5
PIPELINE_PRIORITY_MANUAL_CLIP=8
PIPELINE_PRIORITY_MANUAL_RENDER=10

# Reconciler — re-enqueues orphaned jobs after server restart.
# Set RECONCILE_INTERVAL_MIN=0 to disable the periodic sweep.
RECONCILE_INTERVAL_MIN=5
RECONCILE_STALE_THRESHOLD_MIN=10
