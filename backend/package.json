{
  "name": "clips-backend",
  "version": "1.0.0",
  "description": "Backend for the Clips project.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "auth:create-user": "node src/scripts/create-user.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "package.json"
    ],
    "ignore": [
      "uploads/**",
      "storage/**",
      "temp/**",
      "cache/**",
      "logs/**"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google-cloud/functions": "^4.0.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "archiver": "^7.0.1",
    "argon2": "^0.43.1",
    "axios": "^1.10.0",
    "bull": "^4.16.5",
    "bullmq": "^5.76.10",
    "connect-redis": "^8.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "fluent-ffmpeg": "^2.1.2",
    "multer": "^2.0.1",
    "pg": "^8.16.0",
    "prisma": "^7.7.0",
    "redis": "^5.6.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
