# Backend server.
PORT=8080

# Gemini API settings. GEMINI_API_KEY is required for the analyze (clip selection) stage.
# It is NOT used for transcription — transcription is handled locally by whisper.cpp.
GEMINI_API_KEY="ENTER YOUR API KEY HERE"
LLM_MODEL=gemini-2.5-flash

# whisper.cpp local transcription.
# The binary and default model are baked into the production Docker image.
# For local (non-Docker) development, install whisper.cpp and download a model:
#   brew install whisper-cpp  (macOS)  or  build from https://github.com/ggerganov/whisper.cpp
#   wget https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/app/models/ggml-large-v3-turbo.bin
# Number of CPU threads (default: all available CPUs)
WHISPER_THREADS=
# Language hint — set to e.g. "en" to skip language detection, or leave blank for auto
WHISPER_LANGUAGE=

# PostgreSQL — used by Prisma.
DATABASE_URL="postgresql://vinci:change_this_postgres_password@localhost:5432/vinci_clips?schema=public"

# Session secret — generate with: openssl rand -base64 48
SESSION_SECRET="change_this_session_secret"

# Redis connection for local development.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Local media cleanup.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1

# Optional storage admin token. When set, /clips/storage/* requires
# Authorization: Bearer <token>. Generate one with: openssl rand -base64 32
MEDIA_ADMIN_TOKEN=

# YouTube Data API v3 key — used for video metadata regardless of download provider.
# Get one at https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# Download provider: ytdlp (default) or savenow
VIDEO_DOWNLOAD_PROVIDER=ytdlp

# savenow (video-download-api.com) settings — only needed when VIDEO_DOWNLOAD_PROVIDER=savenow
VIDEO_DOWNLOAD_API_HOST=p.savenow.to
VIDEO_DOWNLOAD_API_KEY=
VIDEO_DOWNLOAD_FORMAT=1080

# yt-dlp bot-detection bypass settings (recommended for VPS/server IPs)
# Uses bgutil-ytdlp-pot-provider Docker sidecar for PO token generation.
# See docker-compose.prod.yml — bgutil-provider service runs on port 4416.
YTDLP_BGUTIL_URL=http://bgutil-provider:4416

# Cookies: export Netscape-format YouTube cookies from Firefox, place under storage/,
# and set to the in-container path. Re-export every 2-4 weeks.
# Example: YTDLP_COOKIES_PATH=/app/cookies/yt-cookies.txt
YTDLP_COOKIES_PATH=
YTDLP_USER_AGENT=

# Cookie expiry monitor — warns in logs (and optional webhook) before cookies expire.
# Runs every COOKIE_MONITOR_INTERVAL_HOURS hours. Warns when daysRemaining <= COOKIE_WARN_DAYS.
# Re-export cookies every 2-4 weeks using .inbox/export_yt_cookies.py + scp + chown 1001:1001.
COOKIE_MONITOR_ENABLED=true
COOKIE_MONITOR_INTERVAL_HOURS=12
COOKIE_WARN_DAYS=3
# Optional: Slack/Discord incoming webhook URL to receive expiry alerts
COOKIE_ALERT_WEBHOOK=
