# Backend server.
PORT=8080

# Gemini API settings. GEMINI_API_KEY is required.
GEMINI_API_KEY="ENTER YOUR API KEY HERE"
LLM_MODEL=gemini-2.5-flash

# PostgreSQL — used by Prisma.
DATABASE_URL="postgresql://vinci:change_this_postgres_password@localhost:5432/vinci_clips?schema=public"

# Session secret — generate with: openssl rand -base64 48
SESSION_SECRET="change_this_session_secret"

# Redis connection for local development.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Local media cleanup.
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1

# Optional storage admin token. When set, /clips/storage/* requires
# Authorization: Bearer <token>. Generate one with: openssl rand -base64 32
MEDIA_ADMIN_TOKEN=

# Optional yt-dlp settings for YouTube imports from VPS/server IPs.
# Put exported Netscape-format cookies under storage/ and point to that file.
YTDLP_COOKIES_PATH=
YTDLP_USER_AGENT=
# POT provider for YouTube bot detection bypass (recommended for VPS deployments).
# Run the bgutil-ytdlp-pot-provider sidecar and set this to point at it.
# In Docker: YTDLP_EXTRACTOR_ARGS=youtubepot-bgutilhttp:base_url=http://pot-provider:4416
YTDLP_EXTRACTOR_ARGS=
