# Port for the backend server
PORT=8080

# Gemini API Key
GEMINI_API_KEY="ENTER YOUR API KEY HERE"
LLM_MODEL=gemini-2.5-flash

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Local media cleanup
MEDIA_CLEANUP_ENABLED=true
MEDIA_CLEANUP_INTERVAL_HOURS=6
MEDIA_TEMP_RETENTION_HOURS=24
MEDIA_UNREFERENCED_RETENTION_HOURS=1

# Optional. When set, /clips/storage/* requires Authorization: Bearer <token>
# Generate one with: openssl rand -base64 32
MEDIA_ADMIN_TOKEN=
