generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  role         String       @default("admin")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  transcripts  Transcript[]
}

model Transcript {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId           String
  user             User      @relation(fields: [userId], references: [id])

  originalFilename String?
  videoUrl         String?
  mp3Url           String?
  thumbnailUrl     String?
  duration         Float?
  status           String    @default("uploading")
  failureReason    String?
  failedAt         DateTime?
  failedStage      String?
  platform         String?
  externalVideoId  String?
  importUrl        String?

  transcript       Json?
  clips            Json?
  processingJob    Json?
  analysisMetadata Json?
  reframeAssets    Json?

  @@index([userId, createdAt])
}

model BlockedWord {
  id        String   @id @default(cuid())
  term      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptTemplate {
  id        String   @id @default(cuid())
  kind      String   // 'transcription' | 'clipAnalysis' | 'hookRegen'
  name      String
  body      String   @db.Text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model DriveExport {
  id         String   @id @default(uuid())
  userId     String
  folderId   String
  folderName String
  status     String   @default("running") // running | completed | failed | partial
  items      Json     // [{ transcriptId, clipIndex, videoId, name, status, error?, requeues? }]
  total      Int
  completed  Int      @default(0)
  failed     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model CaptionTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  isSeeded    Boolean  @default(false)
  usage       String   @default("both")

  fontName    String   @default("DejaVu Sans")
  fontColor   String   @default("#ffffff")
  outlineColor String  @default("#000000")
  backColor   String?
  outlineWidth Float   @default(1)
  shadow      Boolean  @default(false)
  shadowDepth Float    @default(1)
  bold        Boolean  @default(true)
  italic      Boolean  @default(false)
  underline   Boolean  @default(false)
  alignment   Int      @default(2)
  scaleX      Float    @default(1)
  scaleY      Float    @default(1)
  spacing     Float    @default(0)
  uppercase   Boolean  @default(true)
  borderStyle Int      @default(1)

  layouts     Json
  preview     Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
